# BuildKit reads this for deploy/builders/Dockerfile only (context = repo root).
# Never bake secrets or local state into the builder image.
.git
.env
.env.*
!.env.example
**/.secrets
**/kubeconfig
**/*.tfstate
**/*.tfstate.backup
**/.terraform
node_modules
vendor
storage/app
storage/logs
storage/framework/cache/data
bootstrap/cache/*.php
coverage.xml
.story
tests
