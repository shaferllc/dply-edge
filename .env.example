APP_NAME=dply
APP_ENV=local
DPLY_QUICK_LOGIN_ENABLED=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Laravel Octane (optional). When the app is served over HTTPS (Valet/Herd,
# reverse proxy, or production TLS), set OCTANE_HTTPS=true so absolute URLs
# are generated with https://. OCTANE_SERVER: roadrunner|swoole|frankenphp
# OCTANE_SERVER=frankenphp
# OCTANE_HTTPS=true
# ASSET_URL="${APP_URL}"
# Public site gate: true shows /coming-soon to guests. Default off (site is live).
# COMING_SOON=false

# Control-plane runtime split (production). Default `all` = single-box / local dev.
# See docs/dply-production-runtime.md
# DPLY_RUNTIME=all
# DPLY_RUNTIME=web
# DPLY_RUNTIME=worker
# DPLY_WORKER_ROLE=primary
# DPLY_WORKER_ROLE=replica
# HORIZON_NAME=dply-worker-1
# Control-plane supervisor template sync (dply.yaml supervisor: / dply:self:sync-supervisor).
# Set false once processes: → dply-sv-* owns Horizon on the box.
# DPLY_SELF_SUPERVISOR_TEMPLATES=true
# DPLY_SELF_SUPERVISOR_CONF_D=/etc/supervisor/conf.d
# DPLY_SELF_SUPERVISOR_INSTALL_AS=dply-platform.conf
# DPLY_SELF_SUPERVISORD_CONF=/etc/supervisor/supervisord.conf
# Queue names + process counts live in config/horizon.php (no HORIZON_QUEUES env).
# DPLY_EDGE_BUILD_QUEUE=dply-provision
# DPLY_NOTIFICATION_QUEUE=default

# CLI is hosted from this app at /cli/install.sh + /cli/dply-cli.tgz until @dply/cli is on npm.
# install.sh + tarball bake the *request* origin (the host you curled), not APP_URL —
# so `curl https://dply.test/cli/install.sh` downloads from dply.test even when APP_URL
# points elsewhere. Optional fallback for offline/pack builds:
# DPLY_CLI_DEFAULT_BASE_URL=https://dply.test

# Local-only Production data mirror (`/live/*`) — remote API origin for device-flow
# + proxied inventory. Only active when APP_ENV=local. Defaults to DPLY_CLI_DEFAULT_BASE_URL.
# DPLY_LIVE_API_BASE_URL=https://dply.dev
# DPLY_LIVE_API_CACHE_TTL=20
# DPLY_LIVE_API_TIMEOUT=30
# DPLY_CLI_INSTALL_METHOD=tarball
# DPLY_CLI_NPM_PUBLISHED=false
# DPLY_CLI_NPM_PACKAGE=@dply/cli

# Optional: public URL cloud VMs / workers use for TaskRunner signed webhooks (stack provision).
# When APP_URL is not reachable from the server (e.g. http://127.0.0.1), set this to your tunnel
# or ingress HTTPS origin. Leave unset to use APP_URL for signed routes.
# DPLY_PUBLIC_APP_URL=https://dply.tunnel.dply.io

# When tunnelling the app (e.g. Beyond Code Expose at https://expose.dev), set APP_URL (and
# ASSET_URL if you use a CDN) to the public https URL so OAuth redirects and signed URLs match.
# DigitalOcean droplet provisioning uses the API + polling jobs — no inbound “server ready”
# callback. Site deploy webhooks are separate; Expose is mainly for control-plane OAuth/Git.
# TRUSTED_PROXIES=*

# Solo → Expose pane: local URL to tunnel (see beyondcode/expose in composer.json require-dev).
# SOLO_EXPOSE_SHARE_URL=https://dply.test
# If `expose` is installed globally on PATH: SOLO_EXPOSE_COMMAND=expose

# Solo → optional Jetty (or any shell) for inbound HTTPS callbacks: tunnel points here; proxy to Laravel.
# Enables a "Jetty" lazy pane in `php artisan solo`. Example: java -jar /path/to/jetty.jar
# JETTY_START_COMMAND=


# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4


LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dply
DB_USERNAME=postgres
DB_PASSWORD=
# PHPUnit uses a separate database (see phpunit.xml: DB_DATABASE=dply_edge_testing).
# Create it once: createdb dply_edge_testing
# Tests with RefreshDatabase refuse to run against any other DB name unless listed here:
# DPLY_TESTING_DATABASES=dply_edge_testing
# PostgreSQL client binaries for `php artisan schema:dump` when local PATH is older than the server.
# Example for Apple Silicon Homebrew + DBngin PostgreSQL 17:
# DB_SCHEMA_BINARY_PATH=/opt/homebrew/opt/postgresql@17/bin
DB_SCHEMA_BINARY_PATH=

# DB_URL=postgresql://postgres@127.0.0.1:5432/dply?schema=public

# `database` stores sessions in the `sessions` table (see database/migrations/*_create_sessions_table.php). Run `php artisan migrate`.
# For a quick local setup without that table, use SESSION_DRIVER=file.
SESSION_DRIVER=database
SESSION_DOMAIN=null

# Use `reverb` when running `php artisan reverb:start` (see composer script `composer dev`).
# If queues run (Horizon/queue:work) but Reverb is not started, broadcast jobs will fail with
# Pusher/cURL connection errors — use `log` or `null` here until Reverb is up.
BROADCAST_CONNECTION=reverb

# Laravel Reverb (WebSockets). `php artisan reverb:install` generates app id/key/secret.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# --- Local Reverb ---
# Port Reverb binds to (`php artisan reverb:start`). 8080 is often busy.
# Optional override for the browser port. If unset: http uses REVERB_SERVER_PORT; https in APP_ENV=local
# also uses REVERB_SERVER_PORT (TLS on Reverb via Valet/Herd certs — no nginx). Production https defaults to 443.
# REVERB_PORT=8081
# http = ws://. https = wss:// — with REVERB_HOST matching your *.test site, Reverb loads Valet/Herd TLS certs.

# Must match REVERB_* for the client. Rebuild after changes: npm run dev / npm run build.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# false = do not load Laravel Echo (no WebSocket client). Useful when Reverb is not running.
# VITE_REVERB_ENABLED=true
# true = skip the localhost+wss and mixed-content guards (e.g. TLS-terminated Reverb on localhost).
# VITE_REVERB_BYPASS_LOCAL_GUARD=false
#

# dply Logs — app-log drain (sites' "dply Logs" channel → app_logs → App logs panel).
# Set these on the box that owns the drain (control plane / dedicated drain host) and
# run the dply:log-drain:listen receiver there (deploy/supervisor/dply-log-drain.conf).
# The same HOST/PORT are injected into each site's .env for the dply Logs channel.
# Transport is syslog-style lines over TCP, TLS-terminated by default and routed by a
# per-site token. Open the TCP port only from your site servers. Leave blank to disable.
# DPLY_LOG_DRAIN_HOST=
# DPLY_LOG_DRAIN_PORT=9514
# TLS: on by default; the receiver terminates TLS with this cert/key (PEM). Sites then
# connect with tls://. Set false ONLY on a trusted/private network with no cert (tcp://).
# DPLY_LOG_DRAIN_TLS=true
# DPLY_LOG_DRAIN_TLS_CERT=/etc/dply/log-drain.crt
# DPLY_LOG_DRAIN_TLS_KEY=/etc/dply/log-drain.key
# DPLY_LOG_DRAIN_TLS_PASSPHRASE=
# Retention for received records (days) + per-site ingest cap (records per window).
# DPLY_LOG_DRAIN_RETENTION_DAYS=30
# DPLY_LOG_DRAIN_RATE_MAX=600
# DPLY_LOG_DRAIN_RATE_WINDOW=60
# To ship THIS app's own logs to the drain (dogfood): add `dply_logs` to LOG_STACK,
# set DPLY_LOG_DRAIN_TOKEN to this app's drain token, and turn on
# LOG_STACK_IGNORE_EXCEPTIONS so a drain hiccup can't break app logging.
# LOG_STACK=single,dply_logs
# LOG_STACK_IGNORE_EXCEPTIONS=true
# DPLY_LOG_DRAIN_TOKEN=
# DPLY_LOG_DRAIN_LEVEL=warning
# HTTPS site (e.g. https://dply.test) without editing nginx: set REVERB_HOST to that hostname (same as
# Valet/Herd site), REVERB_SCHEME=https, keep REVERB_SERVER_PORT and omit REVERB_PORT (client port matches
# server). Reverb enables TLS when it finds matching certs under ~/.config/valet or Herd. Run reverb:start.
# Alternative: load the app over http:// with REVERB_SCHEME=http, or terminate TLS on 443 with a reverse
# proxy (see https://laravel.com/docs/reverb#running-reverb-behind-a-reverse-proxy).
# Optional nginx example: nginx/reverb-behind-valet.example.conf
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Laravel Horizon only consumes Redis queues. For queued work (cron “Run now”, manage SSH, etc.) to show
# in Horizon and run at all, use: QUEUE_CONNECTION=redis (requires Redis + phpredis). With database
# queues, use `php artisan queue:work` instead — Horizon will stay empty for those jobs.
# Run `composer dev:horizon` or the Horizon pane in Solo. Both use `php artisan horizon:listen`,
# which watches the paths in config/horizon.php and restarts Horizon when local files change.
# Dashboard: /horizon (any signed-in user when APP_ENV=local).
# HORIZON_ALLOWED_EMAILS=you@company.com,ops@company.com
# HORIZON_LOCAL_JOB_TIMEOUT=120
# Parallel queue workers when APP_ENV=local (Horizon). Default 8; raise for more concurrent jobs.
# HORIZON_LOCAL_MAX_PROCESSES=8
# HORIZON_LOCAL_WORKER_MEMORY=128

# Platform admin: /admin menu, Laravel Pulse, and Horizon/Pulse gates (non-local). Comma-separated emails.
# Local and automated tests treat every signed-in user as a platform admin.
# PLATFORM_ADMIN_EMAILS=you@company.com,ops@company.com

# Laravel Pulse (app performance dashboard at /pulse). Requires migrations; optional `php artisan pulse:work` for ingest.
# PULSE_ENABLED=true

# When true, server Manage (config previews / service actions) runs SSH via a queue worker so the
# Livewire request returns immediately. Requires `php artisan queue:work` unless QUEUE_CONNECTION=sync.
# SERVER_MANAGE_QUEUE_REMOTE_TASKS=true
# Optional queue name for those jobs (default queue if unset).
# SERVER_MANAGE_REMOTE_TASK_QUEUE=
# Optional Redis queue for cron “Run now” jobs (default queue if unset). Must be listed in Horizon workers.
# SERVER_CRON_RUN_QUEUE=
# Days to keep cron run history rows (pruned daily by `dply:prune-cron-job-runs`).
# DPLY_CRON_RUN_RETENTION_DAYS=90

# SSH probe cache for server Databases: MySQL/MariaDB (root) and PostgreSQL (postgres user) availability.
# SERVER_DATABASE_CAPABILITIES_TTL=120
# Max SQL import file size (bytes). Orgs can set a lower cap in organizations.database_workspace_settings.import_max_bytes.
# SERVER_DATABASE_IMPORT_MAX_BYTES=10485760
# Optional dedicated queue for SQL export jobs (list in Horizon workers when set).
# SERVER_DATABASE_EXPORT_QUEUE=
# Database backups default to the customer server (not the Dply app). Optional S3 via Backup configurations.
# SERVER_DATABASE_REMOTE_BACKUP_ROOT=/var/lib/dply/database-backups
# SERVER_DATABASE_REMOTE_BACKUP_MAX_BYTES=10737418240
# SERVER_DATABASE_ALLOW_CONTROL_PLANE_STORAGE=false
# SERVER_DATABASE_BACKUP_DISK=local
# Default for new orgs: allow public DB credential share links (override per org in database_workspace_settings JSON).
# SERVER_DATABASE_ORG_SHARES_DEFAULT=true

# Optional ingest/export pipeline for already-stored snapshots (PushServerMetricSnapshotToIngestJob).
# This is separate from the primary guest callback monitor flow. When set, DPLY also derives the
# guest callback base from DPLY_METRICS_INGEST_URL so remote servers post to /api/metrics/guest-push
# on the same public origin.
# Define DPLY_PUBLIC_APP_URL above any line that uses "${DPLY_PUBLIC_APP_URL}" — Docker Compose parses
# `.env` in order and warns if interpolation references run before the variable exists.
# DPLY_METRICS_INGEST_ENABLED=true
# DPLY_METRICS_INGEST_URL="${DPLY_PUBLIC_APP_URL}/api/metrics"
# DPLY_METRICS_INGEST_TOKEN=   # same secret on sender and receiver; required for POST /api/metrics
# DPLY_METRICS_INGEST_TIMEOUT=15
# SERVER_METRICS_INGEST_QUEUE=
# Optional queue for background SSH “metrics readiness” probe (Metrics page). Horizon lists this when set.
# SERVER_METRICS_PROBE_QUEUE=
# Max points on the Metrics line charts (stored samples are pruned separately; default 96).
# DPLY_METRICS_CHART_POINTS=96
#
# Metrics workspace: hidden Livewire poll intervals (seconds).
# DPLY_METRICS_UI_POLL_PROBE_SECONDS=3
# DPLY_METRICS_UI_POLL_REMOTE_TASK_SECONDS=2
# DPLY_METRICS_UI_AUTO_REFRESH_SECONDS=60
#
# When the bundled server-metrics-snapshot.py changes, auto-deploy to ~/.dply/bin/ after collect (queued job).
# DPLY_METRICS_GUEST_SCRIPT_AUTO_UPGRADE=true
# SERVER_METRICS_GUEST_SCRIPT_UPGRADE_QUEUE=
#
# Guest → app push: after “Install monitoring”, Dply writes ~/.dply/metrics-callback.env and installs
# a marked user crontab block that runs every minute by default. The server posts to /api/metrics/guest-push
# using the same public origin as DPLY_METRICS_INGEST_URL when configured, otherwise DPLY_PUBLIC_APP_URL,
# then APP_URL.
# DPLY_METRICS_GUEST_PUSH_ENABLED=true
# SERVER_METRICS_GUEST_PUSH_DEPLOY_QUEUE=
# Five-field cron for the deploy user’s crontab (default every minute). Recheck/repair rewrites the guest cron when this changes.
# DPLY_METRICS_GUEST_PUSH_CRON=* * * * *

# Local only: force stack provisioning to reinstall packages instead of using
# the built-in "already installed; skipping ..." guards.
# DPLY_SERVER_PROVISION_FORCE_REINSTALL=false

# Fake cloud provision (local/testing ONLY): skip vendor APIs; point VM provision jobs at a fixed SSH host.
# See config/server_provision_fake.php and docs/FAKE_CLOUD_PROVISION.md
# DPLY_FAKE_CLOUD_PROVISION=false
# DPLY_FAKE_CLOUD_SSH_HOST=127.0.0.1
# DPLY_FAKE_CLOUD_SSH_PORT=2222
# DPLY_FAKE_CLOUD_SSH_USER=root
# Optional: TaskRunner script dir on fake SSH host (default /root/.dply-task-runner for root, /home/<user>/.dply-task-runner otherwise)
# DPLY_FAKE_CLOUD_SSH_SCRIPT_PATH=
# Optional: local temp dir for TaskRunner scripts (defaults to storage/app/task-runner/temp — do not use /var/tmp on Valet)
# TASK_RUNNER_TEMPORARY_DIRECTORY=
# DPLY_FAKE_CLOUD_PROVIDER_ID=fake-local
# Optional: PEM/OpenSSH private key that matches the test host authorized_keys
# DPLY_FAKE_CLOUD_SSH_PRIVATE_KEY=
# Optional: path to private key when inline env is unset (default: docker/ssh-dev/local_fake_cloud_ed25519)
# DPLY_FAKE_CLOUD_SSH_PRIVATE_KEY_PATH=docker/ssh-dev/local_fake_cloud_ed25519
# Optional: password auth for SshConnection (meta.local_runtime.ssh_password)
# DPLY_FAKE_CLOUD_SSH_PASSWORD=
# Fly.io only: skip Fly API and mark server ready for UI/journey smoke (no RunSetupScriptJob for Fly)
# DPLY_FAKE_CLOUD_FLY_IO_UI_STUB=false

# Local journey sidebar: docker compose SSH container name + optional web terminal URL (e.g. ttyd)
# DPLY_DEV_SSH_COMPOSE_CONTAINER=dply-ssh-dev
# DPLY_DEV_SSH_WEB_TERMINAL_URL=

# Server Insights: optional synthetic “heartbeat” finding (info) to verify jobs + Overview; off by default.
# INSIGHTS_HEARTBEAT_DEFAULT_ENABLED=false
# Queue server + site insight runs after a successful site deploy (correlation + fresh checks).
# INSIGHTS_QUEUE_AFTER_DEPLOY=true
# Digest email: daily (default) or weekly (Monday flush).
# INSIGHTS_DIGEST_FREQUENCY=daily

CACHE_STORE=database
# CACHE_PREFIX=


REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Local 127.0.0.1 stays plaintext tcp. DigitalOcean managed Redis/Valkey
# (:25061 or *.db.ondigitalocean.com) is TLS-only — scheme is inferred as
# tls / rediss if these are omitted, but persist them on the control plane
# so a deploy that rewrites .env from env_file_content does not drop TLS.
# REDIS_SCHEME=tls
# REDIS_URL=rediss://default:password@example.db.ondigitalocean.com:25061
# Reuse the TCP connection across worker process cycles instead of reconnecting
# on every boot. Worth turning on for control-plane workers (many short-lived
# PHP processes against a Redis on the private network).
# REDIS_PERSISTENT=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# OAuth / Git providers (optional; leave empty to hide "Continue with GitHub" etc.)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# DigitalOcean OAuth for Server providers (optional; separate from Git OAuth). Callback: {APP_URL}/credentials/oauth/digitalocean/callback
# DIGITALOCEAN_OAUTH_CLIENT_ID=
# DIGITALOCEAN_OAUTH_CLIENT_SECRET=
# DIGITALOCEAN_OAUTH_REDIRECT_URI=

# Optional personal access token: load DigitalOcean regions & droplet prices on the create-server wizard
# when no org credential is selected (provisioning still uses the selected Server providers credential).
# DIGITALOCEAN_TOKEN=
# Not used to create DigitalOcean Functions namespaces. BYO serverless uses the
# org /credentials token. Dply-hosted (managed) serverless needs the OpenWhisk
# keys below — a PAT alone is not enough.
# DPLY_SERVERLESS_DO_API_HOST=https://faas-nyc1.doserverless.co
# DPLY_SERVERLESS_DO_NAMESPACE=
# DPLY_SERVERLESS_DO_ACCESS_KEY=
# DPLY_SERVERLESS_DO_REGION=nyc1
# Testing / preview hostnames live in config/product/testing_domains.php
# (not env). DNS is Cloudflare first: DPLY_TESTING_CF_API_TOKEN, else
# CLOUDFLARE_API_KEY / CLOUDFLARE_KEY, else DPLY_EDGE_CF_API_TOKEN.
# The Edge token is often Zone:Read only — use DPLY_TESTING_CF_API_TOKEN (or
# CLOUDFLARE_API_KEY) with Zone → DNS → Edit. Namecheap is fallback.
# CLOUDFLARE_KEY is the MAIL token (Email Sending) when a Cloudflare mail
# binding is attached — don't rely on it for DNS.
# DPLY_AUTO_TESTING_HOSTNAME_ENABLED=false

# Serverless function hostnames — dedicated apex, NOT the DPLY_TESTING_DOMAINS pool above.
# Every deployed function answers at {slug}.dply-serverless.cloud (defaults to that apex when unset).
# Needs *.dply-serverless.cloud DNS + wildcard TLS pointed at this app.
# DPLY_SERVERLESS_TESTING_DOMAINS=dply-serverless.cloud
# LOCAL DEV: the public apex resolves to Cloudflare, which proxies to the PRODUCTION origin —
# it can never reach a Valet app. Point the apex at your Valet host so function hostnames
# resolve to this machine ({slug}.dply.test), same trick as DPLY_EDGE_TESTING_DOMAINS below.
# Otherwise use the path URL, which always works locally: {APP_URL}/fn/{slug}
# DPLY_SERVERLESS_TESTING_DOMAINS=dply.test
# DNS target for the function hostname — IP → A record, hostname → CNAME; unset CNAMEs onto the apex.
# DPLY_SERVERLESS_TESTING_DNS_TARGET=
# How the apex answers. Default "wildcard": a hand-created *.dply-serverless.cloud record in
# Cloudflare (proxied, pointed at this app) covers every function — dply makes no DNS API call
# and needs no DNS credential. Universal SSL covers the one wildcard level.
# Set "auto" to have dply write one record per function instead; that needs a Cloudflare token
# with Zone → DNS → Edit on the apex. Note DPLY_EDGE_CF_API_TOKEN has Zone:Read only — it will
# 403 on dns_records — so "auto" requires minting a new token.
# DPLY_SERVERLESS_TESTING_DNS_MODE=wildcard
# DPLY_SERVERLESS_TESTING_DNS_PROVIDER=cloudflare
# DPLY_SERVERLESS_CF_API_TOKEN=

# Optional: php artisan dply:demo-do-server (provisions as DPLY_DEMO_USER_EMAIL into their first org; removes prior dply-demo-* there). Uses DIGITALOCEAN_TOKEN if unset.
# DPLY_DEMO_DO_TOKEN=
# DPLY_DEMO_DO_REGION=nyc1
# DPLY_DEMO_DO_SIZE=s-1vcpu-1gb
# DPLY_DEMO_USER_EMAIL=tom.shafer@gmail.com
# DPLY_DEMO_ORG_SLUG=dply-automated-demo

# After cloud assigns a public IP, wait for TCP :22 before stack setup (avoids “Connection refused”).
# DPLY_SSH_READY_MAX_ATTEMPTS=45
# DPLY_SSH_READY_RETRY_SECONDS=8
# Linux user created during stack setup (same SSH key as root); app uses this for TaskRunner after setup.
# DPLY_SERVER_DEPLOY_SSH_USER=dply

# Install Supervisor during initial stack setup (default true). Set false to skip apt install on provision
# (use Server → Daemons → Install Supervisor if you add programs later).
# DPLY_INSTALL_SUPERVISOR_ON_PROVISION=true

# Product surface feature flags (Pennant; see config/features.php). Set false to hide a surface.
# VM workspace (see docs/DIFFERENTIATION_IDEAS.md)
# Server blueprint defaults ON (live workspace); set =false to fall back to the coming-soon teaser.
# FEATURE_WORKSPACE_SERVER_BLUEPRINT=false
# FEATURE_WORKSPACE_SERVER_BLUEPRINT_PREVIEW=true
# FEATURE_WORKSPACE_WEBSERVER_CONFIG_DIFF=true
# Server maintenance defaults ON (live workspace); set =false to fall back to the coming-soon teaser.
# FEATURE_WORKSPACE_SERVER_MAINTENANCE=false
# FEATURE_WORKSPACE_SERVER_MAINTENANCE_PREVIEW=true
# FEATURE_WORKSPACE_BACKUPS=true
# FEATURE_WORKSPACE_BACKUPS_PREVIEW=true
# FEATURE_WORKSPACE_SSH_ACCESS_GRAPH=true
# FEATURE_WORKSPACE_SSH_ACCESS_GRAPH_PREVIEW=true
# FEATURE_WORKSPACE_PATCH_ADVISOR=true
# FEATURE_WORKSPACE_RELEASE_HYGIENE=true
# FEATURE_WORKSPACE_RELEASE_HYGIENE_PREVIEW=true
# FEATURE_WORKSPACE_DAEMON_SLO=true
# FEATURE_WORKSPACE_CERT_INVENTORY=true
# FEATURE_WORKSPACE_DEPLOY_WINDOWS=true
# FEATURE_WORKSPACE_DEPLOY_WINDOWS_PREVIEW=true
# FEATURE_WORKSPACE_SSH_ACCESS_GRAPH=true
# FEATURE_WORKSPACE_SSH_SESSIONS=true
# FEATURE_WORKSPACE_CONSOLE=true
# FEATURE_WORKSPACE_CONSOLE_PREVIEW=false
# FEATURE_WORKSPACE_CLI=true
# FEATURE_WORKSPACE_CLI_PREVIEW=false
# FEATURE_WORKSPACE_SITE_CLI=true
# FEATURE_WORKSPACE_SITE_CLI_PREVIEW=false
# FEATURE_WORKSPACE_RUN=false
# FEATURE_WORKSPACE_RUN_PREVIEW=true
# FEATURE_WORKSPACE_SERVER_COST=true
# FEATURE_WORKSPACE_SECURITY_DIGEST=true
# FEATURE_WORKSPACE_SECURITY_DIGEST_PREVIEW=true
# Tier B workflows (see docs/TIER_B_WORKFLOW.md)
# FEATURE_LAUNCH_FULL_STACK_WIZARD=true
# FEATURE_GLOBAL_BYO_REPO_CONFIG=true
# FEATURE_GLOBAL_EDGE_DEPLOY_REPLAY=true
# Product surface flags (Cloud, Edge, Serverless). Off = Soon badge in nav + no routes.
# FEATURE_SURFACE_CLOUD=true
# FEATURE_SURFACE_MARKETPLACE=false
# Gates the managed (dply-hosted) option of a site's broadcasting binding. After flipping,
# run: php artisan config:clear && php artisan pennant:purge surface.realtime
# FEATURE_SURFACE_REALTIME=true

# Local Edge dev (no Cloudflare): enable surface.edge + fake backend, then purge stale Pennant rows if
# you previously visited /edge while the flag was off: php artisan pennant:purge surface.edge
# FEATURE_SURFACE_EDGE=true
# DPLY_FAKE_EDGE=true
# Match a Valet-linked domain so {slug}.{domain} resolves locally (see docs/edge-local-development.md):
# DPLY_EDGE_TESTING_DOMAINS=dply.test
# Or a dedicated Edge apex: DPLY_EDGE_TESTING_DOMAINS=edge.test  (valet link --domain=edge)

# dply Edge — first-party static/SSG delivery (R2 + Cloudflare Worker)
# DPLY_EDGE_R2_BUCKET=
# DPLY_EDGE_R2_REGION=auto
# DPLY_EDGE_R2_ENDPOINT=
# DPLY_EDGE_R2_ACCESS_KEY=
# DPLY_EDGE_R2_SECRET=
# DPLY_EDGE_R2_PATH_STYLE=true
# DPLY_EDGE_R2_KEY_PREFIX=edge/
# DPLY_EDGE_CF_ACCOUNT_ID=
# DPLY_EDGE_CF_API_TOKEN=
# DPLY_EDGE_CF_KV_NAMESPACE_ID=
# DPLY_EDGE_CF_CACHE_KV_NAMESPACE_ID=
# DPLY_EDGE_CF_WORKER_SCRIPT=dply-edge
# DPLY_EDGE_CF_ZONE_NAME=dply.host
# DPLY_EDGE_CF_WORKER_ROUTES=*.dply.host/*
# DPLY_EDGE_CF_ANALYTICS_DATASET=dply_edge_requests
# Custom Hostnames (SSL for SaaS) on the managed worker zone — token needs
# Zone → SSL and Certificates → Custom Hostnames Edit. Set false to keep
# CNAME-verify-only (Phase 3) without SaaS certs.
# DPLY_EDGE_CUSTOM_HOSTNAMES=true
# DPLY_EDGE_CUSTOM_HOSTNAME_SSL_METHOD=http
# DPLY_EDGE_CUSTOM_HOSTNAME_FALLBACK_ORIGIN=
# DPLY_EDGE_LOG_INGEST_KEY=
# Must be reachable from the public internet (Cloudflare Workers). Prefer
# DPLY_PUBLIC_APP_URL / a tunnel — local *.test hosts will never receive logs.
# DPLY_EDGE_LOG_INGEST_BASE_URL=${DPLY_PUBLIC_APP_URL}
# DPLY_EDGE_LOGPUSH_ENABLED=false
# DPLY_EDGE_LOGPUSH_SECRET=
# DPLY_EDGE_LOGPUSH_DESTINATION_URL=${APP_URL}/hooks/edge/logpush
# DPLY_EDGE_ACCESS_LOGS_DAYS=7
# DPLY_EDGE_ACCESS_LOGS_KEEP=500
# DPLY_EDGE_WEB_VITALS_DAYS=30
# DPLY_EDGE_WEB_VITALS_KEEP=200
# DPLY_EDGE_PERFORMANCE_HOURLY_DAYS=45
# DPLY_EDGE_PREFER_ANALYTICS_ENGINE=true
# DPLY_EDGE_BUILD_IMAGE=node:22-bookworm
# DPLY_EDGE_BUILD_WARM_IMAGES=node:20-bookworm,node:22-bookworm
# DPLY_EDGE_BUILD_WARM_IMAGES_SCHEDULE=true
# DPLY_EDGE_BUILD_SKIP_PULL_IF_PRESENT=true
# DPLY_EDGE_BUILD_PACKAGE_STORE=true
# DPLY_EDGE_BUILD_PACKAGE_STORE_DIR=
# DPLY_EDGE_BUILD_ASYNC_CACHE_SNAPSHOT=true
# DPLY_EDGE_BUILD_SPARSE_CHECKOUT=true
# DPLY_EDGE_BUILD_MONOREPO_FILTER=true
# Control-plane Horizon pools (config/horizon.php). NOT the same as the generic
# HORIZON_MAX_PROCESSES/HORIZON_TRIES/… vars — those belong to the customer
# worker-pool feature (WorkerPoolHorizonConfig) and are ignored by the control
# plane. Keep BUILD_MAX at or below the worker box's vCPU count (docker builds
# saturate cores); DEPLOY_MAX can be over-subscribed since deploys block on SSH.
# HORIZON_BUILD_MIN_PROCESSES=2
# HORIZON_BUILD_MAX_PROCESSES=4
# HORIZON_BUILD_TIMEOUT=7320
# HORIZON_DEPLOY_MIN_PROCESSES=2
# HORIZON_DEPLOY_MAX_PROCESSES=16
# HORIZON_DEPLOY_TIMEOUT=3600
# HORIZON_FAST_MIN_PROCESSES=1
# HORIZON_FAST_MAX_PROCESSES=10
# Deprecated alias, still honoured as the HORIZON_BUILD_MAX_PROCESSES fallback:
# HORIZON_HEAVY_MAX_PROCESSES=8
# DPLY_EDGE_BUILD_TIMEOUT=900
# Horizon user for Edge Docker socket (control-plane workers; default www-data)
# DPLY_EDGE_BUILD_DOCKER_USER=www-data
# Install Docker at provision time on control-plane workers only (not customer VMs)
# DPLY_PROVISION_EDGE_BUILD_DOCKER=true
# DPLY_EDGE_ARTIFACT_MAX_BYTES=524288000
# DPLY_EDGE_ORIGIN_HEALTHCHECK_TIMEOUT=10
# DPLY_EDGE_ORIGIN_HEALTHCHECK_RETRIES=3
# DPLY_EDGE_ORIGIN_HEALTHCHECK_RETRY_WAIT_MS=1500
# DPLY_EDGE_ORIGIN_HEALTHCHECK_TIMEOUT=10
# DPLY_EDGE_ORIGIN_HEALTHCHECK_RETRIES=3
# DPLY_EDGE_ORIGIN_HEALTHCHECK_RETRY_WAIT_MS=1500
# Production Edge delivery hostnames (on-dply.*); local dev uses dply.test or edge.test — see docs/edge-local-development.md
# DPLY_EDGE_TESTING_DOMAINS=on-dply.live
# Optional DO DNS target when the zone is not the Cloudflare Worker zone:
# DPLY_EDGE_TESTING_DNS_TARGET=
# FEATURE_SURFACE_MARKETPLACE=false

# Server / credential provider feature flags (true/false). Roll out clouds gradually; DigitalOcean + Custom default on.
# DPLY_SERVER_PROVIDER_DIGITALOCEAN=true
# FEATURE_PROVIDER_DIGITALOCEAN=true
# DPLY_SERVER_PROVIDER_CUSTOM=true
# DPLY_SERVER_PROVIDER_HETZNER=true
# FEATURE_PROVIDER_HETZNER=true
# DPLY_SERVER_PROVIDER_VULTR=true
# FEATURE_PROVIDER_VULTR=true
# VULTR_DEFAULT_OS_ID=2284   # Ubuntu 24.04 LTS x64
# VULTR_SSH_USER=root
# App-level Vultr API token for global ops (catalog browse before a credential is
# linked); per-server provisioning still uses each server's own credential.
# VULTR_TOKEN=
# DPLY_SERVER_PROVIDER_LINODE=true
# FEATURE_PROVIDER_LINODE=true
# LINODE_DEFAULT_IMAGE=linode/ubuntu24.04
# LINODE_SSH_USER=root
# App-level Linode (Akamai) API token for global ops (catalog browse before a
# credential is linked); per-server provisioning uses each server's own credential.
# LINODE_TOKEN=
# DPLY_SERVER_PROVIDER_AKAMAI=false
# DPLY_SERVER_PROVIDER_SCALEWAY=false
# DPLY_SERVER_PROVIDER_UPCLOUD=true
# FEATURE_PROVIDER_UPCLOUD=true
# UPCLOUD_DEFAULT_TEMPLATE=01000000-0000-4000-8000-000030200100   # Ubuntu 22.04
# UPCLOUD_SSH_USER=root
# DNS & CDN credential providers (Credentials → DNS & CDN section)
# DPLY_SERVER_PROVIDER_CLOUDFLARE=false
# DPLY_SERVER_PROVIDER_GANDI=false
# DPLY_SERVER_PROVIDER_NAMECHEAP=false
# DPLY_SERVER_PROVIDER_VERCEL_DNS=false
# DPLY_SERVER_PROVIDER_GHCR=false
# DPLY_SERVER_PROVIDER_PLOI=false
# DPLY_SERVER_PROVIDER_FORGE=false
# DPLY_SERVER_PROVIDER_OVH=false
# DPLY_SERVER_PROVIDER_AWS=true
# FEATURE_PROVIDER_AWS=true
# AWS App Runner (Cloud container backend — Settings → Server providers → AWS App Runner)
# DPLY_SERVER_PROVIDER_AWS_APP_RUNNER=true
# FEATURE_PROVIDER_AWS_APP_RUNNER=true
# Optional create-sidebar AWS compute rates (us-east-1 list defaults)
# SUBSCRIPTION_APP_RUNNER_HOURS_PER_MONTH=730
# SUBSCRIPTION_APP_RUNNER_VCPU_USD_PER_HOUR=0.064
# SUBSCRIPTION_APP_RUNNER_MEMORY_GB_USD_PER_HOUR=0.007
# AWS EC2 VM provisioning (Settings → Server providers → AWS, Create server → Amazon EC2)
# AWS_EC2_DEFAULT_IMAGE=ami-xxxxxxxx   # optional; unset = regional Ubuntu 24.04 via SSM
# AWS_EC2_AMI_SSM_PARAMETER=/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id
# AWS_EC2_SECURITY_GROUP_ID=sg-xxxxxxxx  # optional; unset = auto create/find dply-provision (SSH :22)
# AWS_EC2_PROVISION_SECURITY_GROUP=true
# AWS_EC2_PROVISION_SECURITY_GROUP_NAME=dply-provision
# AWS_EC2_SSH_USER=ubuntu
#
# dply-MANAGED servers (dply provisions on its OWN cloud account, billed cost-plus).
# Single operator-configured backend: set DPLY_MANAGED_PROVIDER to hetzner or vultr
# and fill in that backend's platform token. Managed create is only offered when the
# active backend's token is set. Curated regions/sizes + cost-plus rates live in
# config/managed_servers.php and config/subscription.php.
# DPLY_MANAGED_PROVIDER=hetzner
# DPLY_MANAGED_HETZNER_API_TOKEN=
# DPLY_MANAGED_HETZNER_REGION=fsn1
# DPLY_MANAGED_HETZNER_IMAGE=ubuntu-24.04
# DPLY_MANAGED_VULTR_API_TOKEN=
# DPLY_MANAGED_VULTR_REGION=ewr
# DPLY_MANAGED_VULTR_IMAGE=2284   # Vultr os_id (Ubuntu 24.04 LTS x64)
# DPLY_SERVER_PROVIDER_GCP=false
# FEATURE_PROVIDER_GCP=false
# DPLY_SERVER_PROVIDER_AZURE=false
# FEATURE_PROVIDER_AZURE=false
# DPLY_SERVER_PROVIDER_ORACLE=false
# FEATURE_PROVIDER_ORACLE=false

# Profile VAT: EU VIES check on save (soft warnings). Disable locally if you want to skip outbound requests.
# VAT_VIES_ENABLED=true
# VAT_VIES_TIMEOUT=8

# Stripe billing (Cashier). Run `php artisan dply:billing:provision-stripe --dry-run` to generate price IDs.
# STRIPE_KEY=pk_test_...
# STRIPE_SECRET=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STANDARD_SERVERLESS=price_...
# STRIPE_PRICE_STANDARD_SERVERLESS_YEARLY=price_...
# STRIPE_PRICE_STANDARD_CLOUD=price_...
# STRIPE_PRICE_STANDARD_CLOUD_YEARLY=price_...
# STRIPE_PRICE_STANDARD_EDGE=price_...
# STRIPE_PRICE_STANDARD_EDGE_YEARLY=price_...
# STRIPE_PRICE_STANDARD_EDGE_SSR=price_...
# STRIPE_PRICE_STANDARD_EDGE_SSR_YEARLY=price_...
# STRIPE_PRICE_STANDARD_EDGE_USAGE=price_...
# STRIPE_PRICE_STANDARD_EDGE_LB_ENDPOINT=price_...
# Plan tiers (monthly) + Team extra seat — created by dply:billing:provision-stripe.
# STRIPE_PRICE_TIER_PRO=price_...
# STRIPE_PRICE_TIER_TEAM=price_...
# STRIPE_PRICE_TEAM_SEAT=price_...
# Managed Realtime — per connection-tier (created by dply:billing:provision-stripe).
# STRIPE_PRICE_STANDARD_REALTIME_STARTER=price_...
# STRIPE_PRICE_STANDARD_REALTIME_STARTER_YEARLY=price_...
# STRIPE_PRICE_STANDARD_REALTIME_GROWTH=price_...
# STRIPE_PRICE_STANDARD_REALTIME_GROWTH_YEARLY=price_...
# STRIPE_PRICE_STANDARD_REALTIME_SCALE=price_...
# STRIPE_PRICE_STANDARD_REALTIME_SCALE_YEARLY=price_...

# Edge usage billing — $2/site flat + overage above included allowances.
# Unit rates are Cloudflare cost floor (cents); markup_percent is applied on top
# (default 40%, same idea as Cloud). Effective customer rates ≈ rate × 1.4.
# DPLY_EDGE_USAGE_BILLING_ENABLED=true
# DPLY_EDGE_USAGE_MARKUP_PERCENT=40
# DPLY_EDGE_USAGE_REQUESTS_CENTS_PER_MILLION=50
# DPLY_EDGE_USAGE_EGRESS_CENTS_PER_GB=5
# DPLY_EDGE_USAGE_R2_STORAGE_CENTS_PER_GB_MONTH=3
# DPLY_EDGE_USAGE_R2_CLASS_A_CENTS_PER_MILLION=450
# DPLY_EDGE_USAGE_R2_CLASS_B_CENTS_PER_MILLION=36
# DPLY_EDGE_USAGE_INCLUDED_REQUESTS_PER_SITE=5000000
# DPLY_EDGE_USAGE_INCLUDED_EGRESS_GB_PER_SITE=100
# DPLY_EDGE_USAGE_INCLUDED_R2_STORAGE_GB_PER_SITE=5

# STRIPE_PRICE_ENTERPRISE=price_...

# Subscription limits (free tier when not on Pro Stripe price). Pro = unlimited servers & sites.
# SUBSCRIPTION_SERVERS_FREE_LIMIT=3
# SUBSCRIPTION_SITES_FREE_LIMIT=10

# Email verification for dashboard / gated actions (defaults off when APP_ENV=local). Uncomment to require it locally.
# DPLY_REQUIRE_EMAIL_VERIFICATION=true

# When true, only orgs on Pro can create tokens from Settings → API keys.
# DPLY_API_TOKENS_REQUIRE_PAID_PLAN=true

# Referrals: Stripe customer balance credit (cents) for referrer when a referred user’s org pays for Pro. 0 = track only.
# REFERRAL_BONUS_CREDIT_CENTS=1500

# Notification channel types shown in the UI (comma-separated). Add pushover, microsoft_teams, rocketchat, google_chat, mobile_app when supported end-to-end.
# DPLY_NOTIFICATION_CHANNEL_TYPES=slack,discord,email,telegram,intercom,pagerduty,microsoft_teams,webhook

# Slack app behind the one-click "Add to Slack" notification channel. Optional:
# without it the button hides and operators paste incoming webhook URLs instead.
# Create at https://api.slack.com/apps → OAuth & Permissions → Bot Token Scopes:
#   chat:write, chat:write.public, channels:read, groups:read, team:read
# Then turn on Manage Distribution so other workspaces can install it.
# Redirect URL must match SLACK_REDIRECT_URI (Slack rejects `.test` hosts —
# use your Expose/ngrok URL locally); unset falls back to APP_URL + the callback route.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=https://your-tunnel.example.com/notifications/oauth/slack/callback

# Discord application behind the one-click "Add to Discord" notification channel.
# Optional: without it the button hides and operators paste webhook URLs instead.
# Create at https://discord.com/developers/applications:
#   OAuth2 → Redirects: add the DISCORD_REDIRECT_URI value below
#   Bot → Reset Token: gives DISCORD_BOT_TOKEN
# All three are required. Unlike Slack, the bot token is application-wide and is
# NOT returned by the OAuth exchange — without it the flow would connect a server
# that can never receive a message, so the button stays hidden until it is set.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_REDIRECT_URI=https://your-tunnel.example.com/notifications/oauth/discord/callback

# Telegram bot behind the one-click "Connect Telegram" notification channel.
# Optional: without it the button hides and operators paste a bot token + chat ID.
# Create the bot with @BotFather (/newbot) to get TELEGRAM_BOT_TOKEN.
# TELEGRAM_WEBHOOK_SECRET is yours to invent (any random string) — Telegram echoes
# it on every delivery and it is the ONLY thing authenticating the public
# /hooks/telegram endpoint, so treat it like a password.
# Telegram requires a public HTTPS URL, so use your Expose URL locally, then run:
#   php artisan telegram:set-webhook
#   php artisan telegram:set-webhook --show    # to debug delivery failures
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=https://your-tunnel.example.com/hooks/telegram

# Intercom, behind the "Intercom" notification channel and Laravel's `intercom`
# notification driver. Optional, and normally left unset: operators paste their
# own access token on each channel so every org reaches its own Intercom
# workspace. These are only the fallback for $user->notify() on a notifiable with
# no Intercom channel of its own — the setup the laravel-notification-channels
# docs describe.
# Get the token at https://app.intercom.com/a/apps/_/developer-hub → your app
# (create one if needed; it never has to be published) → Configure → Authentication.
# Enable the "Write conversations" permission there BEFORE copying the token —
# changing permissions does not update an already-issued token.
# INTERCOM_ADMIN_ID is the teammate messages are sent as: Intercom → Settings →
# Teammates, the numeric ID in the teammate's URL, on the same workspace as the
# token. Intercom rejects a message with no `from`, so the fallback cannot send
# without it.
# INTERCOM_REGION is us (default), eu, or au — a token issued for one region 401s
# against the others, which reads exactly like a bad token.
# See docs/NOTIFICATIONS_INTERCOM.md.
# INTERCOM_API_KEY=
# INTERCOM_ADMIN_ID=
# INTERCOM_REGION=us

# PagerDuty, behind the "PagerDuty" notification channel and the `PagerDuty`
# notification driver. Optional, and normally left unset: operators paste their
# own integration key on each channel, which is how they choose which PagerDuty
# service — and so which escalation policy — an alert pages.
# Get the key from PagerDuty → Services → your service → Integrations →
# Add an integration → Events API v2. It must be v2; a v1 key has a different
# payload shape and will be rejected.
# PAGERDUTY_REGION is us (default) or eu. A key from one region is rejected by
# the other with a 400 naming the routing key, so it reads like a bad key.
# See docs/NOTIFICATIONS_PAGERDUTY.md.
# PAGERDUTY_ROUTING_KEY=
# PAGERDUTY_REGION=us

# Microsoft Teams needs no env vars: each channel stores its own Power Automate
# Workflows URL, which already encodes the target team and channel.
# Note the flow, because most Teams guides still describe the wrong one — dply
# posts an Adaptive Card to a *Workflows* webhook ("Post to a channel when a
# webhook request is received"), not a MessageCard to the old "Incoming Webhook"
# connector. Microsoft retired connectors in May 2026 and dply refuses those URLs.
# See docs/NOTIFICATIONS_MICROSOFT_TEAMS.md.

# Server → Firewall add-rule form defaults (overrides config/server_firewall.php `new_rule`).
# SERVER_FIREWALL_DEFAULT_PORT=443
# SERVER_FIREWALL_DEFAULT_PROTOCOL=tcp
# SERVER_FIREWALL_DEFAULT_SOURCE=any
# SERVER_FIREWALL_DEFAULT_ACTION=allow
# SERVER_FIREWALL_DEFAULT_ENABLED=true

# Server → Services: background systemd inventory (see config/server_services.php).
# SERVER_SYSTEMD_INVENTORY_JOB_ENABLED=true
# SERVER_SYSTEMD_INVENTORY_SCHEDULE_ENABLED=true
# SERVER_SYSTEMD_SYNC_QUEUE=  # optional dedicated queue; add to Horizon when set
# SERVER_SERVICES_DEPLOYER_SYSTEMD_ACTIONS=false  # org can also set services_preferences.deployer_systemd_actions_enabled
# SERVER_SERVICES_SYSTEMD_NOTIFICATIONS_DIGEST=immediate  # immediate|hourly (hourly batches per channel; scheduler runs flush)
# SERVER_SERVICES_SYSTEMD_DIGEST_FLUSH_ENABLED=true


# Optional: public URL of the Vite dev server when the app uses a tunnel (e.g. Expose) on APP_URL
# but HMR/assets must load from a second tunnel pointed at port 5173. Must be plain https URL only
# (no ANSI/terminal styling). If unset, npm run dev writes local host:port to public/hot.
# VITE_DEV_SERVER_URL=https://your-vite-share.tunnel.example.com

# Fleet operator API — GET /api/operator/summary (Bearer or X-Fleet-Operator-Token). Same secret as fleet-console polling.
# FLEET_OPERATOR_TOKEN=
