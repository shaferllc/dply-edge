# Production settings for dply's own container and builders (APP_ENV=production
# makes Laravel load this file). Committed on purpose: nothing here is secret.
# Secrets and per-install values come from the real environment, which wins
# (deploy/self/make-env.sh, docs/self-hosting.md). Workers allow 128 env values,
# so settings live here, not in the container env.

APP_NAME=dply-edge
APP_URL=https://edge.dply.io
APP_DEBUG=false
LOG_CHANNEL=stderr
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
BROADCAST_CONNECTION=log
TRUSTED_PROXIES=*
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
DB_CONNECTION=pgsql
DB_SSLMODE=require
PGGSSENCMODE=disable
DPLY_WORKER_TIMEOUT=900
DPLY_QUICK_LOGIN_ENABLED=false
DPLY_EDGE_SKIP_CARD_CHECK=false

# Mail: Cloudflare Email Service SMTP (password = API token with Email Sending: Edit)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mx.cloudflare.net
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=api_token
MAIL_FROM_ADDRESS=hello@dply.io
MAIL_FROM_NAME=dply

# Cloudflare account, delivery Worker, KV, R2
DPLY_EDGE_CF_ACCOUNT_ID=7b04f7af0455bad4f97632f4f490f5de
CLOUDFLARE_ACCOUNT_ID=7b04f7af0455bad4f97632f4f490f5de
