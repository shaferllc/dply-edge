# .env.testing — the automated test environment.
#
# Laravel loads this file INSTEAD OF .env (they are not merged) whenever
# APP_ENV=testing, which phpunit.xml sets. Its job is to make the suite
# hermetic. Before it existed the tests read whatever was in a developer's
# personal, untracked .env — so whether a test passed depended on a file not in
# version control. Setting FEATURE_SURFACE_EDGE=true locally was enough to
# change the suite's results.
#
# Rules for this file:
#   - No real credentials. It is committed. Every secret below is a fake.
#   - No FEATURE_* flags. config/features.php holds the defaults; a test that
#     needs a flag sets it itself (Feature::define() / usesFeatures()).
#   - Nothing that phpunit.xml already pins (DB_*, QUEUE_CONNECTION,
#     CACHE_STORE, MAIL_MAILER, DPLY_FAKE_EDGE, …). Its <env> block wins, and
#     duplicating a value here just invites the two to drift apart.

APP_NAME=dply
APP_ENV=testing
# Generated for tests only. This key encrypts nothing real — do not reuse it.
APP_KEY=base64:u1rqFSyAdyOMVZ2u/2GSG1wWpF/5VtJMAhxdbnn2LB8=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

#==============================================================================
# Deterministic fakes. A test that reaches a live API is a test that fails on a
# plane — and one that bills a real account.
#==============================================================================
DPLY_FAKE_EDGE=true
DPLY_FAKE_REALTIME=true

# Managed testing hostnames. Code under test (edge + serverless DNS) reads
# these to build hostnames; keep them stable so assertions can rely on them.
DPLY_TESTING_DOMAINS=dply.test
DPLY_TESTING_DOMAINS_CLOUDFLARE=on-dply.cc
DPLY_VM_TESTING_APEX=on-dply.cc
DPLY_EDGE_TESTING_DOMAINS=edge.test

# Comma-separated ALLOWLIST of database names RefreshDatabase may wipe (see
# tests/TestCase.php). NOT a boolean — setting it to `false` makes the allowlist
# literally ['false'], and every RefreshDatabase test aborts. This is the guard
# that stops the suite migrating over a real database; keep it exact.
DPLY_TESTING_DATABASES=dply_edge_testing

#==============================================================================
# Third-party credentials — all fake or empty. Present so config() resolves to
# a predictable value, never so a request is made.
#==============================================================================
STRIPE_KEY=pk_test_fake
STRIPE_SECRET=sk_test_fake
STRIPE_WEBHOOK_SECRET=whsec_fake

DPLY_EDGE_CF_ACCOUNT_ID=
DPLY_EDGE_CF_API_TOKEN=
DPLY_EDGE_R2_BUCKET=
DPLY_EDGE_R2_ACCESS_KEY=
DPLY_EDGE_R2_SECRET=

DIGITALOCEAN_TOKEN=
HETZNER_TOKEN=
VULTR_TOKEN=
LINODE_TOKEN=
