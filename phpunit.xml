<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnEmptyTestSuite="true"
         defaultTestSuite="Unit,Feature"
>
    <testsuites>

        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <!-- Tests that live beside the code they cover. The Modules suite went
             with the VM platform (every module-local test file was TaskRunner's),
             so only the Actions framework's own tests remain here.

             Registered so it is runnable and visible (`composer test:app`), but
             kept OUT of defaultTestSuite above until the rot is paid down. -->
        <!-- @see composer.json scripts: test, test:app, test:all -->
        <testsuite name="App">
            <directory suffix="Test.php">app/Actions</directory>
        </testsuite>

        <!-- Pest arch tests: structural invariants checked by parsing app/.
             The whole-app scan costs ~45s and needs 2G (the file raises
             memory_limit itself), so `composer test` skips it by excluding the
             `arch` group, and CI runs `composer test:arch` as its own step.

             NOTE: defaultTestSuite cannot exclude this one. Pest collects the
             whole tests/ directory on top of the suites declared here, so a
             testsuite filter only gates directories *outside* tests/ (the
             Modules and App suites). Group exclusion is what actually works
             for anything under tests/. -->
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <!-- Test files live under app/ too; they are not production code and
             would otherwise inflate/skew coverage of the real classes. -->
        <exclude>
            <directory>app/Actions/Attributes/tests</directory>
            <directory>app/Actions/Concerns/tests</directory>
            <directory>app/Actions/Decorators/tests</directory>
            <directory>app/Actions/Tests</directory>
            <directory>app/Modules/*/Tests</directory>
        </exclude>
    </source>
    <php>

        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Parallel RefreshDatabase: if lock errors persist locally, set max_locks_per_transaction=256+ in DBngin Postgres config and restart. -->
        <!-- Parallel + coverage: parent merge uses 2G via tests/bootstrap.php; prefer sequential coverage for HTML reports on large suites. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="dply_testing"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="DPLY_FAKE_EDGE" value="true"/>
        <!-- Serverless checkout tests clone from local fixture repositories;
             GitCloneUrl refuses bare filesystem paths everywhere else. -->
        <env name="DPLY_GIT_CLONE_ALLOW_LOCAL_PATHS" value="true"/>
        <env name="DPLY_CHOOSE_APP_ENABLED" value="false"/>
        <!-- Slack "Add to Slack" off by default: with a client id present the
             channel form defaults to the OAuth picker, which would change what
             every pasted-webhook test is asserting against. Tests that exercise
             the OAuth path set these two keys themselves. -->
        <env name="SLACK_CLIENT_ID" value=""/>
        <env name="SLACK_CLIENT_SECRET" value=""/>
        <env name="DISCORD_CLIENT_ID" value=""/>
        <env name="DISCORD_CLIENT_SECRET" value=""/>
        <env name="DISCORD_BOT_TOKEN" value=""/>
        <env name="TELEGRAM_BOT_TOKEN" value=""/>
        <env name="TELEGRAM_WEBHOOK_SECRET" value=""/>
        <ini name="max_execution_time" value="0"/>
        <ini name="memory_limit" value="1G"/>
    </php>
</phpunit>
