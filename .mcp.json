{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "dply": {
            "type": "http",
            "url": "https://edge.dply.io/mcp",
            "headers": {
                "Authorization": "Bearer ${DPLY_MCP_TOKEN}"
            }
        }
    }
}
