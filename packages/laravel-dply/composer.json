{
    "name": "dply/laravel",
    "description": "Run Laravel queues on Cloudflare Queues when your app is deployed as a dply Edge container.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/queue": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "league/flysystem": "^3.0"
    },
    "autoload": {
        "psr-4": { "Dply\\Laravel\\": "src/" }
    },
    "extra": {
        "laravel": { "providers": ["Dply\\Laravel\\DplyServiceProvider"] }
    }
}
