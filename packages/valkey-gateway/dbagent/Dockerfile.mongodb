# dply MongoDB image: stock MongoDB with dbagent as PID 1 (the pod stays up
# while the database sleeps). Build from packages/valkey-gateway:
#   docker build -f dbagent/Dockerfile.mongodb -t dply/mongodb:7 .
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY dbagent/ ./dbagent/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /dbagent ./dbagent

FROM mongo:7
COPY --from=build /dbagent /usr/local/bin/dbagent
ENV ENGINE=mongodb
# uid 999, the same as the Postgres image, so the gateway's pod spec fits both.
USER mongodb
ENTRYPOINT ["/usr/local/bin/dbagent"]
