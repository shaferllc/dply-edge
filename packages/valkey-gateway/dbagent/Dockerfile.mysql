# dply MySQL image: stock MySQL 8.4 with dbagent as PID 1 (the pod stays up
# while the database sleeps). Build from packages/valkey-gateway:
#   docker build -f dbagent/Dockerfile.mysql -t dply/mysql:8 .
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY dbagent/ ./dbagent/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /dbagent ./dbagent

# The stock image is MySQL's "minimal" build, without mysqlbinlog (the
# point-in-time replay tool). Percona's build of the same 8.4.11 needs only
# system libraries. Keep both on the same 8.4 patch release.
FROM percona/percona-server:8.4@sha256:e99ac73a80a3b60b6276c7ec5445aba457d175b5642449c983f089291266690e AS binlog

FROM mysql:8.4.11
COPY --from=binlog /usr/bin/mysqlbinlog /usr/bin/mysqlbinlog
COPY --from=build /dbagent /usr/local/bin/dbagent
ENV ENGINE=mysql
# uid 999, the same as the Postgres and MongoDB images.
USER mysql
ENTRYPOINT ["/usr/local/bin/dbagent"]
